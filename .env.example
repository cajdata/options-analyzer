# Copy this file to .env and fill in what you have. .env is gitignored.

# --- Alpaca (required for live data) -------------------------------------
# Paper-trading keys are enough: this app only reads market data.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = keys are from a paper account, false = from a live account.
ALPACA_PAPER=true
# indicative = free (delayed trades, modified quotes). opra = real time, needs
# the Algo Trader Plus subscription and a signed OPRA agreement.
ALPACA_OPTIONS_FEED=indicative
# iex = the only stock feed that works without a subscription.
ALPACA_STOCK_FEED=iex

# --- Earnings data (set at least one) --------------------------------------
# SEC EDGAR: free, no key, no daily limit. The SEC asks automated clients to
# identify themselves, e.g. "Jane Doe jane@example.com". Past earnings dates only.
SEC_USER_AGENT=
# Alpha Vantage: free key, about 25 requests a day. Adds confirmed upcoming
# earnings dates. Its history (with EPS surprises) is used only for stocks where
# SEC EDGAR is not set or has too few reports, to stay inside the daily limit.
ALPHAVANTAGE_API_KEY=

# --- AI write-ups (optional) -------------------------------------------------
# Leave blank to turn the AI brief off. Needs: pip install -e ".[ai]"
ANTHROPIC_API_KEY=
AI_MODEL=
# Reasoning effort sent with the request. Set to "none" for an older model that
# rejects the setting.
AI_EFFORT=high

# --- Scanner defaults -----------------------------------------------------
# Symbols always included in a discovery scan.
WATCHLIST=
RISK_FREE_RATE=0.04
